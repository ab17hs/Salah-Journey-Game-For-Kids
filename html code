/* ============================================================
   BACKGROUND PARTICLES
   ============================================================ */
const bgCanvas = document.getElementById('bgCanvas');
const bgCtx = bgCanvas.getContext('2d');
let particles = [];

function resizeBg() {
  bgCanvas.width = window.innerWidth;
  bgCanvas.height = window.innerHeight;
}

function initParticles() {
  particles = [];
  const count = Math.min(60, Math.floor(window.innerWidth / 14));
  for (let i = 0; i < count; i++) {
    particles.push({
      x: Math.random() * bgCanvas.width,
      y: Math.random() * bgCanvas.height,
      r: Math.random() * 2 + 0.5,
      dx: (Math.random() - 0.5) * 0.3,
      dy: -Math.random() * 0.5 - 0.2,
      alpha: Math.random() * 0.6 + 0.2,
      symbol: Math.random() > 0.6 ? '★' : '·',
      size: Math.random() * 10 + 6
    });
  }
}

function drawBg() {
  bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
  particles.forEach(p => {
    bgCtx.save();
    bgCtx.globalAlpha = p.alpha;
    bgCtx.fillStyle = '#f7c948';
    bgCtx.font = `${p.size}px serif`;
    bgCtx.fillText(p.symbol, p.x, p.y);
    bgCtx.restore();
    p.x += p.dx; p.y += p.dy;
    if (p.y < -20) { p.y = bgCanvas.height + 10; p.x = Math.random() * bgCanvas.width; }
    if (p.x < -10) p.x = bgCanvas.width + 10;
    if (p.x > bgCanvas.width + 10) p.x = -10;
  });
  requestAnimationFrame(drawBg);
}

/* ============================================================
   CONFETTI
   ============================================================ */
const confCanvas = document.getElementById('confettiCanvas');
const confCtx = confCanvas.getContext('2d');
let confetti = [], confettiRunning = false;

function startConfetti(dur=4000) {
  confCanvas.width = window.innerWidth;
  confCanvas.height = window.innerHeight;
  confCanvas.style.display = 'block';
  confetti = [];
  for (let i = 0; i < 160; i++) {
    confetti.push({
      x: Math.random() * confCanvas.width,
      y: -20 - Math.random() * 200,
      w: 6 + Math.random() * 8,
      h: 10 + Math.random() * 6,
      color: ['#f7c948','#00d4aa','#ff6b9d','#8b5cf6','#fb923c','#22c55e','#ffffff'][Math.floor(Math.random()*7)],
      dx: (Math.random()-0.5)*3,
      dy: 2 + Math.random()*4,
      rot: Math.random()*360,
      drot: (Math.random()-0.5)*8
    });
  }
  confettiRunning = true;
  drawConfetti();
  setTimeout(() => { confettiRunning = false; confCanvas.style.display='none'; }, dur);
}

function drawConfetti() {
  if (!confettiRunning) return;
  confCtx.clearRect(0, 0, confCanvas.width, confCanvas.height);
  confetti.forEach(c => {
    confCtx.save();
    confCtx.translate(c.x + c.w/2, c.y + c.h/2);
    confCtx.rotate(c.rot * Math.PI/180);
    confCtx.fillStyle = c.color;
    confCtx.fillRect(-c.w/2, -c.h/2, c.w, c.h);
    confCtx.restore();
    c.x += c.dx; c.y += c.dy; c.rot += c.drot;
    if (c.y > confCanvas.height + 20) {
      c.y = -20; c.x = Math.random() * confCanvas.width;
    }
  });
  requestAnimationFrame(drawConfetti);
}

