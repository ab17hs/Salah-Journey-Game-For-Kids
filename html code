  document.getElementById('cardTitle').textContent = stage.emoji + ' ' + stage.name;
  document.getElementById('cardSub').textContent = stage.sub;
  document.getElementById('starCount').textContent = state.stars;
  rotateMascot();
  renderPath();
  renderPhasePips();

  const phases = [renderLearnPhase, renderQuizPhase1, renderQuizPhase2];
  const phaseIdx = Math.min(state.currentPhase, phases.length-1);
  phases[phaseIdx](stage);

  // Animate card
  const card = document.getElementById('mainCard');
  card.style.animation = 'none';
  requestAnimationFrame(() => { card.style.animation = 'fly-in 0.4s ease both'; });
