/* ============================================================
   PHASE 0 – LEARN
   ============================================================ */
function renderLearnPhase(stage) {
  setSpeech(`Let's learn "${stage.name}"! 📚`);
  const words = stage.text.split(' ');
  let html = `<div class="text-display" id="learnText">`;
  words.forEach((w,i) => {
    html += `<span class="word-highlight" id="wh${i}">${w} </span>`;
  });
  html += `</div>`;
  html += `<div style="text-align:center;opacity:0.7;font-size:14px;margin-top:8px">👆 Watch each word light up!</div>`;
  document.getElementById('contentArea').innerHTML = html;
  document.getElementById('actionBtns').innerHTML = `
    <button class="btn btn-primary" id="learnNextBtn" onclick="advancePhase()" style="opacity:0.4;pointer-events:none">
      I'm Ready! ➡️
    </button>`;
  highlightWords(words, 0);
}

function highlightWords(words, idx) {
  if (idx > 0) {
    const prev = document.getElementById('wh'+(idx-1));
    if (prev) prev.classList.remove('lit');
  }
  if (idx >= words.length) {
    // done highlighting
    setSpeech("Great listening! Now let's practice! 💪");
    const btn = document.getElementById('learnNextBtn');
    if (btn) { btn.style.opacity='1'; btn.style.pointerEvents='auto'; }
    return;
  }
  const el = document.getElementById('wh'+idx);
  if (el) el.classList.add('lit');
  const delay = Math.max(300, Math.min(800, 5000 / words.length));
  setTimeout(() => highlightWords(words, idx+1), delay);
}

/* ============================================================
   PHASE 1 – QUIZ: REPEAT AFTER ME
   ============================================================ */
function renderQuizPhase1(stage) {
  setSpeech("Tap each part to say it! 👂");
  const lines = stage.text.match(/[^.!?]+[.!?]*/g) || stage.text.split(/(?<=\s{2})|(?=\s{2})/);
  // Split into meaningful chunks (by spaces in long texts, or natural breaks)
  const chunks = splitIntoChunks(stage.text, 5);

  let html = `<div style="font-size:14px;font-weight:700;opacity:0.75;margin-bottom:10px;text-align:center">
    Tap each part to practice repeating it! 🌟</div>`;
  html += `<div class="repeat-chunks" id="repeatChunks">`;
  chunks.forEach((c, i) => {
    html += `<button class="chunk-btn" data-idx="${i}" onclick="tapChunk(this)">
      <span class="chunk-icon">🔊</span>
      <span class="chunk-text">${c}</span>
    </button>`;
  });
  html += `</div>`;

  document.getElementById('contentArea').innerHTML = html;
  document.getElementById('actionBtns').innerHTML = `
    <button class="btn btn-primary" id="repeatNextBtn" onclick="advancePhase()" style="opacity:0.4;pointer-events:auto">
      Next Quiz ➡️
    </button>`;
  // Allow skipping repeat phase
  setTimeout(() => {
    const btn = document.getElementById('repeatNextBtn');
    if(btn) { btn.style.opacity='1'; }
  }, 500);
}

let tappedChunks = new Set();
function tapChunk(btn) {
  const idx = btn.dataset.idx;
  btn.classList.add('tapped');
  btn.querySelector('.chunk-icon').textContent = '✅';
  tappedChunks.add(idx);
  playCorrectSound();
  setSpeech(randFrom(["Say it out loud! 📢", "Repeat after me! 🗣️", "MashaAllah! ✨", "Good practice! 💪"]));
}

function splitIntoChunks(text, maxWords) {
  const words = text.split(' ');
  const chunks = [];
  for (let i = 0; i < words.length; i += maxWords) {
    chunks.push(words.slice(i, i + maxWords).join(' '));
  }
  return chunks;
}



/* ============================================================
   PHASE 2 – ROTATING QUIZ (tap / arrange / memory)
   ============================================================ */
function renderQuizPhase2(stage) {
  const quizType = state.currentStage % 3; // 0=tap, 1=arrange, 2=memory
  if (quizType === 0) renderTapQuiz(stage);
  else if (quizType === 1) renderArrangeQuiz(stage);
  else renderMemoryQuiz(stage);
}

/* --- TAP CORRECT WORD --- */
function renderTapQuiz(stage) {
  setSpeech("Tap the RIGHT word! 🎯");
  const words = stage.text.replace(/[',]/g,'').split(' ').filter(w => w.length > 2);
  const uniqueWords = [...new Set(words)];
  const targetWord = uniqueWords[Math.floor(Math.random() * Math.min(uniqueWords.length, 8))];

  const wrongPool = [];
  STAGES.forEach(s => {
    s.text.split(' ').forEach(w => {
      const c = w.replace(/[',]/g,'');
      if (c.length > 2 && c.toLowerCase() !== targetWord.toLowerCase()) wrongPool.push(c);
    });
  });
  shuffleArr(wrongPool);
  const options = [targetWord, ...wrongPool.filter((w,i,a)=>a.indexOf(w)===i).slice(0,3)];
  shuffleArr(options);

  const highlighted = stage.text.replace(
    new RegExp(`(${escapeRegex(targetWord)})`, 'i'),
    '<span style="background:rgba(247,201,72,0.35);border-radius:6px;padding:2px 8px;border:2px dashed var(--gold);font-weight:900"> ___ </span>'
  );

  document.getElementById('contentArea').innerHTML = `
    <div class="text-display" style="font-size:15px;line-height:2">${highlighted}</div>
    <div style="font-size:14px;font-weight:700;opacity:0.75;text-align:center;margin:10px 0">Which word fills the blank? 🤔</div>
    <div class="word-options" id="wordOpts">
      ${options.map(opt=>`<button class="word-btn" onclick="checkWordAnswer(this,'${opt}','${targetWord}')">${opt}</button>`).join('')}
    </div>`;
  document.getElementById('actionBtns').innerHTML = '';
  quizAnswered = false;
}

let quizAnswered = false;
function checkWordAnswer(btn, chosen, correct) {
  if (quizAnswered) return;
  quizAnswered = true;
  const allBtns = document.querySelectorAll('.word-btn');
  allBtns.forEach(b => b.style.pointerEvents = 'none');
  if (chosen.toLowerCase() === correct.toLowerCase()) {
    btn.classList.add('correct');
    playCorrectSound(); awardStars(1);
    showFeedback('correct', randFrom(CORRECT_MSGS));
    setSpeech(randFrom(['You got it! 🎯','MashaAllah! ✨','Brilliant! 💫']));
    const r = btn.getBoundingClientRect();
    showStarBurst(r.left + r.width/2, r.top);
    setTimeout(() => advancePhase(), 1800);
  } else {
    btn.classList.add('wrong'); playWrongSound();
    showFeedback('wrong', randFrom(WRONG_MSGS));
    setSpeech("Almost! Try again! 💪");
    allBtns.forEach(b => { if(b.textContent.trim().toLowerCase()===correct.toLowerCase()) b.classList.add('correct'); });
    setTimeout(() => {
      quizAnswered = false;
      allBtns.forEach(b => { b.classList.remove('correct','wrong'); b.style.pointerEvents='auto'; });
    }, 2000);
  }
}

/* --- ARRANGE WORDS --- */
let arrangeAnswer = [], arrangeTarget = [];
function renderArrangeQuiz(stage) {
  setSpeech("Put the words in order! 🔢");
  // Take first 5-7 words
  const allWords = stage.text.split(' ').filter(w=>w.trim());
  const slice = allWords.slice(0, Math.min(7, allWords.length));
  arrangeTarget = [...slice];
  arrangeAnswer = [];
  const shuffled = shuffleArr([...slice]);

  document.getElementById('contentArea').innerHTML = `
    <div style="font-size:14px;font-weight:700;opacity:0.75;text-align:center;margin-bottom:8px">Arrange the words in the right order! ✨</div>
    <div style="font-size:12px;opacity:0.6;text-align:center;margin-bottom:8px">Tap a word to place it, tap placed word to remove</div>
    <div class="arrange-area" id="arrangeZone"></div>
    <div class="arrange-bank" id="arrangeBank">
      ${shuffled.map((w,i)=>`<button class="bank-word" id="bw${i}" onclick="pickBankWord('${escapeQuote(w)}',${i})">${w}</button>`).join('')}
    </div>`;
  document.getElementById('actionBtns').innerHTML = `
    <button class="btn btn-primary btn-sm" onclick="checkArrange()">Check! ✅</button>
    <button class="btn btn-sm" style="background:var(--card-bg);border:1.5px solid var(--card-border);color:var(--text-main)" onclick="clearArrange()">Clear 🔄</button>`;
}

function escapeQuote(s) { return s.replace(/'/g,"\\'"); }

function pickBankWord(word, idx) {
  const btn = document.getElementById('bw'+idx);
  if (btn && btn.classList.contains('used')) return;
  arrangeAnswer.push({ word, idx });
  if (btn) btn.classList.add('used');

  const zone = document.getElementById('arrangeZone');
  const slot = document.createElement('div');
  slot.className = 'arrange-slot';
  slot.textContent = word;
  slot.dataset.bankIdx = idx;
  slot.onclick = function() {
    // Remove from answer
    arrangeAnswer = arrangeAnswer.filter(a => a.idx !== parseInt(this.dataset.bankIdx));
    const bw = document.getElementById('bw'+this.dataset.bankIdx);
    if (bw) bw.classList.remove('used');
    this.remove();
  };
  zone.appendChild(slot);
}

function clearArrange() {
  arrangeAnswer = [];
  document.querySelectorAll('.bank-word').forEach(b => b.classList.remove('used'));
  document.getElementById('arrangeZone').innerHTML = '';
}

function checkArrange() {
  const userWords = arrangeAnswer.map(a => a.word.replace(/[',]/g,'').toLowerCase());
  const targetWords = arrangeTarget.map(w => w.replace(/[',]/g,'').toLowerCase());
  if (userWords.length < targetWords.length) {
    setSpeech("Place all the words first! 🌟"); return;
  }
  let correct = true;
  for (let i=0;i<targetWords.length;i++) {
    if (userWords[i] !== targetWords[i]) { correct = false; break; }
  }
  if (correct) {
    playCorrectSound(); awardStars(1);
    showFeedback('correct', randFrom(CORRECT_MSGS));
    setSpeech("Perfect order! MashaAllah! 🌟");
    document.querySelectorAll('.arrange-slot').forEach(s => s.style.background = 'linear-gradient(135deg,var(--green),#16a34a)');
    setTimeout(() => advancePhase(), 1800);
  } else {
    playWrongSound();
    showFeedback('wrong', randFrom(WRONG_MSGS));
    setSpeech("Not quite right! Try again! 💪");
    document.querySelectorAll('.arrange-slot').forEach(s => s.style.animation = 'shake 0.4s');
    setTimeout(() => {
      document.querySelectorAll('.arrange-slot').forEach(s => s.style.animation = '');
    }, 500);
  }
}

/* --- MEMORY MATCH --- */
let memFlipped = [], memMatched = 0, memLocked = false, memPairs = [];
function renderMemoryQuiz(stage) {
  setSpeech("Match the pairs! 🧠");
  // Create 4 pairs from first 4 chunks of the text
  const words = stage.text.split(' ').filter(w=>w.trim());
  const chunks = [];
  for (let i=0;i<words.length;i+=3) chunks.push(words.slice(i,i+3).join(' '));
  const usedChunks = chunks.slice(0,4);

  // Each pair: chunk A and chunk B (same text, find by pair id)
  memPairs = [];
  usedChunks.forEach((c,i) => { memPairs.push({id:i,text:c}); memPairs.push({id:i,text:c}); });
  shuffleArr(memPairs);
  memFlipped = []; memMatched = 0; memLocked = false;

  let html = `<div style="font-size:13px;font-weight:700;opacity:0.75;text-align:center;margin-bottom:8px">
    Tap to flip and find matching pairs! 🌟 (${usedChunks.length} pairs)</div>`;
  html += `<div class="memory-grid" id="memGrid">`;
  memPairs.forEach((_,i) => {
    html += `<div class="mem-card face-down" id="mc${i}" onclick="flipMemCard(${i})"></div>`;
  });
  html += `</div>`;
  document.getElementById('contentArea').innerHTML = html;
  document.getElementById('actionBtns').innerHTML = '';
}

function flipMemCard(idx) {
  if (memLocked) return;
  const card = document.getElementById('mc'+idx);
  if (!card || card.classList.contains('matched') || memFlipped.find(f=>f.idx===idx)) return;

  card.classList.remove('face-down');
  card.textContent = memPairs[idx].text;
  memFlipped.push({idx, id: memPairs[idx].id});

  if (memFlipped.length === 2) {
    memLocked = true;
    const [a, b] = memFlipped;
    if (a.id === b.id) {
      // Match!
      playCorrectSound();
      document.getElementById('mc'+a.idx).classList.add('matched');
      document.getElementById('mc'+b.idx).classList.add('matched');
      memMatched++;
      memFlipped = [];
      memLocked = false;
      setSpeech(randFrom(['Match! 🎉','MashaAllah! ✨','Great memory! 🧠']));
      if (memMatched === memPairs.length/2) {
        awardStars(2);
        showFeedback('correct','All matched! 🎉');
        setSpeech("Perfect memory! You're a star! ⭐");
        setTimeout(() => advancePhase(), 2000);
      }
    } else {
      // No match
      playWrongSound();
      setSpeech("Not a match, try again! 👀");
      setTimeout(() => {
        document.getElementById('mc'+a.idx).classList.add('face-down');
        document.getElementById('mc'+a.idx).textContent = '';
        document.getElementById('mc'+b.idx).classList.add('face-down');
        document.getElementById('mc'+b.idx).textContent = '';
        memFlipped = []; memLocked = false;
      }, 1200);
    }
  }
}

function escapeRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

/* ============================================================
   PHASE ADVANCEMENT
   ============================================================ */
function advancePhase() {
  tappedChunks.clear();
  if (state.currentPhase < 2) {
    state.currentPhase++;
    saveState();
    renderStage();
  } else {
    completeStage();
  }
}

function completeStage() {
  const stage = STAGES[state.currentStage];
  if (!state.completedStages.includes(state.currentStage)) {
    state.completedStages.push(state.currentStage);
    awardStars(2); // Bonus for completing stage
    // Award badge
    if (!state.badges.find(b => b.name === stage.badge.name)) {
      state.badges.push(stage.badge);
      showBadgePopup(stage.badge);
    }
  }
  saveState();
  setSpeech("Stage complete! Amazing! 🏆");

  // Show completion message then move on
  document.getElementById('contentArea').innerHTML = `
    <div style="text-align:center;padding:20px">
      <div style="font-size:60px;animation:tada 0.9s ease">${stage.emoji}</div>
      <div style="font-size:24px;font-weight:900;color:var(--gold);margin:12px 0">Stage Complete!</div>
      <div style="font-size:17px;opacity:0.85">${randFrom(CORRECT_MSGS)}</div>
      <div style="margin-top:12px;font-size:15px;opacity:0.7">You earned the <strong>${stage.badge.icon} ${stage.badge.name}</strong> badge!</div>
    </div>`;
  document.getElementById('actionBtns').innerHTML = `
    <button class="btn btn-primary" onclick="nextStage()">Next Stage ➡️</button>`;

  playCelebrationSound();
  startConfetti(3000);
}

function nextStage() {
  state.currentStage++;
  state.currentPhase = 0;
  saveState();
  renderStage();
}

/* ============================================================
   STAR AWARD
   ============================================================ */
function awardStars(n) {
  state.stars += n;
  document.getElementById('starCount').textContent = state.stars;
  playStarSound();
  saveState();
}

/* ============================================================
   BADGE POPUP
   ============================================================ */
function showBadgePopup(badge) {
  const el = document.createElement('div');
  el.style.cssText = `position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
    background:linear-gradient(135deg,#1a1a4e,#2d1b69);border:3px solid var(--gold);
    border-radius:24px;padding:32px 40px;text-align:center;z-index:150;
    box-shadow:0 20px 60px rgba(0,0,0,0.5);animation:feedback-pop 0.5s cubic-bezier(0.34,1.56,0.64,1)`;
  el.innerHTML = `
    <div style="font-size:64px">${badge.icon}</div>
    <div style="font-size:20px;font-weight:900;color:var(--gold);margin:8px 0">New Badge!</div>
    <div style="font-size:18px;font-weight:700">${badge.name}</div>
  `;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 2500);
}

/* ============================================================
   FINAL SCREEN
   ============================================================ */
function showFinalScreen() {
  showScreen('finalScreen');
  playCelebrationSound();
  startConfetti(8000);

  // Trophy animation
  const trophy = document.getElementById('trophyAnim');
  trophy.style.display = 'block';

  document.getElementById('finalStarCount').textContent = state.stars;

  // Generate star display
  const maxStars = STAGES.length * 5;
  const earned = Math.min(state.stars, maxStars);
  const pct = earned / maxStars;
  let starStr = '';
  for (let i=0;i<5;i++) starStr += i < Math.round(pct*5) ? '⭐' : '☆';
  document.getElementById('certStars').textContent = starStr;

  // Badges
  const badgeRow = document.getElementById('finalBadgeRow');
  badgeRow.innerHTML = '';
  state.badges.forEach(b => {
    badgeRow.innerHTML += `<div class="badge earned"><div class="badge-icon">${b.icon}</div><div class="badge-name">${b.name}</div></div>`;
  });
  if (state.badges.length === 0) {
    badgeRow.innerHTML = '<div style="opacity:0.6;font-size:14px">Complete stages to earn badges! 🏅</div>';
  }

  setSpeech = () => {}; // disable
}

function printCert() { window.print(); }

/* ============================================================
   UTILITIES
   ============================================================ */
function shuffleArr(arr) {
  for (let i = arr.length-1; i > 0; i--) {
    const j = Math.floor(Math.random()*(i+1));
    [arr[i],arr[j]] = [arr[j],arr[i]];
  }
  return arr;
}

function toggleSound() {
  state.soundOn = !state.soundOn;
  saveState();
  const txt = state.soundOn ? '🔊' : '🔇';
  document.getElementById('soundBtn').textContent = txt + (state.soundOn ? ' Sound On' : ' Muted');
  if (document.getElementById('soundBtn2')) document.getElementById('soundBtn2').textContent = txt;
}

function toggleDark() {
  state.darkMode = !state.darkMode;
  document.body.classList.toggle('light-mode', state.darkMode);
  saveState();
  const btn = document.getElementById('darkBtn');
  if (btn) btn.textContent = state.darkMode ? '☀️ Day' : '🌙 Night';
}

function openParentModal() {
  document.getElementById('pm-stars').textContent = state.stars;
  document.getElementById('pm-stages').textContent = `${state.completedStages.length} / ${STAGES.length}`;
  document.getElementById('pm-badges').textContent = state.badges.length;
  document.getElementById('parentModal').classList.add('open');
}
function closeParentModal() { document.getElementById('parentModal').classList.remove('open'); }

function confirmReset() {
  if (confirm('Reset all progress? This cannot be undone.')) {
    localStorage.removeItem('salahGame');
    state = { currentStage:0, currentPhase:0, stars:0, badges:[], completedStages:[], soundOn:true, darkMode:false };
    closeParentModal();
    goHome();
  }
}

/* ============================================================
   INIT
   ============================================================ */
window.addEventListener('resize', () => { resizeBg(); initParticles(); });

(function init() {
  resizeBg();
  initParticles();
  drawBg();
  loadState();
  updateHomeScreen();
  if (state.darkMode) document.body.classList.add('light-mode');
  if (!state.soundOn) {
    document.getElementById('soundBtn').textContent = '🔇 Muted';
  }
})();
</script>
